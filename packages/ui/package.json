{
  "name": "@dtheo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "dtheo/ui React components: Base UI primitives, Tailwind v4, Apple-native defaults.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/theme": "./src/lib/theme.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./meta": "./src/meta/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
