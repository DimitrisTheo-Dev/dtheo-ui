{
  "name": "dtheo-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dtheo/docs dev",
    "build": "pnpm tokens && pnpm --filter @dtheo/docs build",
    "start": "pnpm --filter @dtheo/docs start",
    "tokens": "pnpm --filter @dtheo/tokens build",
    "tokens:check": "pnpm --filter @dtheo/tokens check",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts e2e/a11y.spec.ts e2e/interactions.spec.ts e2e/agents.spec.ts e2e/charts.spec.ts",
    "check": "pnpm tokens:check && pnpm lint && pnpm typecheck && pnpm test && pnpm design:check",
    "design:check": "node packages/cli/src/bin.mjs check \"apps/docs/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\"",
    "test:visual": "playwright test e2e/visual.spec.ts --project=desktop",
    "test:visual:linux": "bash scripts/visual-linux.sh",
    "usage": "node scripts/gen-usage.mjs",
    "examples": "node scripts/gen-examples.mjs",
    "screens": "node scripts/screens.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.28.10"
}
