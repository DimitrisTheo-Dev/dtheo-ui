{
  "plugins": ["react", "typescript", "jsx-a11y", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/no-autofocus": "off",
    "unicorn/no-array-sort": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Switch", "Checkbox", "Radio", "Slider"],
        "depth": 3
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/generated/**",
    "playwright-report/**",
    "test-results/**",
    ".impeccable/**"
  ]
}
