{
  "printWidth": 110,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/generated/**",
    "pnpm-lock.yaml",
    "**/*.md",
    ".impeccable/**",
    "packages/ui/src/styles/tokens.css",
    "packages/ui/src/styles/theme.css",
    "apps/docs/examples/index.ts",
    "apps/docs/lib/usage-data.ts",
    "**/next-env.d.ts"
  ]
}
